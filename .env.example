# ── Public site ──────────────────────────────────────────────
# Canonical origin used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://example.com
# Set to "true" ONLY on the production domain. Anything else serves noindex + a disallow-all robots.txt.
ALLOW_INDEXING=false
# A MONITORED inbox. Shown on /contact and on every directory page as the removal route, and used as the
# fallback when the contact form cannot store a message. Required before ALLOW_INDEXING=true (COMPLIANCE.md).
# Inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Database (Supabase / Postgres) ───────────────────────────
# Server-only. Never expose the service role key to the browser or prefix it with NEXT_PUBLIC_.
# Required for the contact form to store submissions. Without them the API returns 503
# (and the form tells the visitor nothing was saved) rather than pretending to succeed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Used once the App / OS are wired to Supabase Auth (see ROADMAP.md) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Transactional email (not yet wired) ──────────────────────
# RESEND_API_KEY=
# EMAIL_FROM="BabyBlue <hello@your-domain>"

# ── Error monitoring (not yet wired) ─────────────────────────
# SENTRY_DSN=
